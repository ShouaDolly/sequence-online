{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sequence-online",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-18",
  "workers_dev": true,

  "assets": {
    "directory": "./public"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ]
}
